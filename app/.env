# =============================================
# PERSONAL MANAGER AI MICROSERVICE CONFIGURATION
# =============================================

# Environment
ENVIRONMENT=development
DEBUG=True
# .env
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Ollama Configuration
# OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text:v1.5
# ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=AIzaSyD35qEIPIwjDl7L673zIe7EEN4ngkcrN6o
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434
REDIS_URL=redis://localhost:6379

# Security & Authentication
# .env
API_SECRET_KEY=supersecretapikey
API_KEYS=abc123,def456,ghi789

# Application Settings
APP_NAME=PersonalManagerAI-Microservice
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Memory & AI Configuration
EMBEDDING_DIMENSIONS=768
SHORT_MEMORY_MAXLEN=20
RAG_TOP_K=5

# Performance & Timeouts
OLLAMA_TIMEOUT=120
DATABASE_TIMEOUT=30
REQUEST_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
MAX_LOG_SIZE=10485760
LOG_BACKUP_COUNT=5

# Microservice Integration
MAIN_APP_URL=http://localhost:3000
MAIN_APP_API_KEY=your-main-app-api-key-if-needed
SERVICE_PORT=8001

# Feature Flags
ENABLE_WEBSOCKETS=True
ENABLE_MEMORY_STORAGE=True
ENABLE_AGENT_ROUTING=True
