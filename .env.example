# Copy this file to .env and replace values for your local environment.
# Never commit real credentials or production secrets.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskpilot
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Configure one provider as needed. Ollama is used by the current fallback path.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Reserved setting; current API routes do not implement authentication with it.
API_SHARED_SECRET=
